{
  "name": "micro-voxel-world",
  "version": "0.1.0",
  "description": "Micro Voxel World browser game and asset tools",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run assets:validate && npm run build && npm run test:browser",
    "assets:validate": "node tools/assets/validate.ts",
    "assets:export": "node tools/assets/export.ts",
    "assets:benchmark": "node tools/assets/benchmark.ts"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
