import {test,expect,type Page} from '@playwright/test';
const sample=async(page:Page)=>JSON.parse(await page.getByLabel('Horde diagnostics').getAttribute('data-sample')??'{}') as {seed:number;running:boolean;ticks:number;total:number;alive:number;killed:number;cleared:number;resident:number;counts:{near:number;medium:number;far:number;individuals:number};homeTier:string;homeAlive:number;homeHealth:number[];homeProgress:number;terrain:number;jobs:number;results:number;settled:boolean;geometries:number;records:number;rendered:{near:number;medium:number;far:number;walls:number}};
const combat=async(page:Page)=>JSON.parse(await page.getByLabel('Combat diagnostics').getAttribute('data-sample')??'{}') as {shots:number;damage:number;effects:number;voices:number};
async function settled(page:Page){await expect.poll(async()=>(await sample(page)).settled,{timeout:20000}).toBe(true);expect((await sample(page)).geometries).toBeLessThanOrEqual(56);}
test('hordes move, react, conserve partial clearance across tiers/travel/reload and fully clear durably',async({page})=>{
  test.setTimeout(90000);const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('/tools/hordes/');await settled(page);const initial=await sample(page);expect(initial.total).toBe(2592);expect(initial.resident).toBe(49);expect(initial.homeAlive).toBe(32);expect(initial.homeTier).toBe('near');expect(initial.rendered.near).toBeGreaterThan(0);expect(initial.rendered.medium).toBeGreaterThan(0);expect(initial.rendered.far).toBeGreaterThan(0);
  await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await expect.poll(async()=>(await sample(page)).homeProgress).not.toBe(initial.homeProgress);await page.keyboard.down('Space');await expect.poll(async()=>(await sample(page)).homeAlive).toBeLessThan(32);await page.keyboard.up('Space');await page.getByRole('button',{name:'Pause',exact:true}).click();await expect.poll(async()=>(await sample(page)).running).toBe(false);const partial=await sample(page);expect(partial.homeAlive).toBeGreaterThan(0);expect(partial.alive+partial.killed).toBe(2592);expect((await combat(page)).damage).toBeGreaterThan(0);await page.waitForTimeout(200);expect((await sample(page)).ticks).toBe(partial.ticks);
  await page.screenshot({path:'test-results/phase-11-near.png',fullPage:true});
  await page.getByRole('button',{name:'Medium view',exact:true}).click();await expect.poll(async()=>(await sample(page)).homeTier).toBe('medium');expect((await sample(page)).homeHealth).toEqual(partial.homeHealth);
  await page.getByRole('button',{name:'Far view',exact:true}).click();await expect.poll(async()=>(await sample(page)).homeTier).toBe('far');expect((await sample(page)).homeHealth).toEqual(partial.homeHealth);await page.screenshot({path:'test-results/phase-11-far.png',fullPage:true});
  await page.getByRole('button',{name:'Travel east 256 m',exact:true}).click();await expect.poll(async()=>(await sample(page)).homeTier).toBe('unloaded');expect((await sample(page)).resident).toBeLessThanOrEqual(49);
  await page.getByRole('button',{name:'Near view / Home',exact:true}).click();await settled(page);await expect.poll(async()=>(await sample(page)).homeTier).toBe('near');expect((await sample(page)).homeHealth).toEqual(partial.homeHealth);await page.reload();await settled(page);expect((await sample(page)).homeHealth).toEqual(partial.homeHealth);
  await page.getByLabel('Weapon',{exact:true}).selectOption('shell');await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await page.keyboard.down('Space');await expect.poll(async()=>(await sample(page)).homeAlive,{timeout:20000}).toBe(0);await page.keyboard.up('Space');await page.getByRole('button',{name:'Pause',exact:true}).click();await expect.poll(async()=>(await sample(page)).running).toBe(false);const cleared=await sample(page);expect(cleared.cleared).toBeGreaterThanOrEqual(1);expect(cleared.alive+cleared.killed).toBe(2592);expect((await combat(page)).effects).toBeLessThanOrEqual(128);
  await page.reload();await settled(page);expect((await sample(page)).homeAlive).toBe(0);expect((await sample(page)).killed).toBe(cleared.killed);await page.screenshot({path:'test-results/phase-11-cleared.png',fullPage:true});
  await page.getByLabel('World seed').fill('104');await page.getByRole('button',{name:'Load seed',exact:true}).click();await expect.poll(async()=>(await sample(page)).seed).toBe(104);await expect.poll(async()=>(await sample(page)).homeAlive).toBe(32);await page.getByLabel('World seed').fill('103');await page.getByRole('button',{name:'Load seed',exact:true}).click();await expect.poll(async()=>(await sample(page)).seed).toBe(103);await expect.poll(async()=>(await sample(page)).homeAlive).toBe(0);expect((await sample(page)).records).toBeLessThanOrEqual(81);
  await page.evaluate(()=>{window.dispatchEvent(new Event('pagehide'));window.dispatchEvent(new Event('pagehide'));});await expect(page.locator('canvas')).toHaveCount(0);expect(errors).toEqual([]);
});
test('corrupt and denied storage are visible session-only modes; viewport focus scopes fire',async({page,browser})=>{
  await page.addInitScript(()=>localStorage.setItem('mvw:hordes:v1:g1:p1:103','corrupt'));await page.goto('/tools/hordes/');await expect(page.getByLabel('Population save status')).toContainText('Session only');
  await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await page.getByLabel('World seed').focus();await expect.poll(async()=>(await sample(page)).running).toBe(false);await page.keyboard.down('Space');await page.waitForTimeout(150);await page.keyboard.up('Space');expect((await combat(page)).shots).toBe(0);
  await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await page.keyboard.down('Space');await expect.poll(async()=>(await combat(page)).damage).toBeGreaterThan(0);await page.keyboard.up('Space');expect(await page.evaluate(()=>localStorage.getItem('mvw:hordes:v1:g1:p1:103'))).toBe('corrupt');
  const context=await browser.newContext(),denied=await context.newPage();await denied.addInitScript(()=>{Storage.prototype.setItem=()=>{throw new Error('quota');};});await denied.goto('/tools/hordes/');await denied.getByRole('button',{name:'Start / Resume',exact:true}).click();await denied.keyboard.down('Space');await expect(denied.getByLabel('Population save status')).toContainText('Session only');await denied.keyboard.up('Space');await context.close();
});
test('horde lab reports WebGL and worker startup fallback',async({page,browser})=>{
  await page.addInitScript(()=>{window.Worker=class{constructor(){throw new Error('blocked');}} as unknown as typeof Worker;});await page.goto('/tools/hordes/');await expect(page.getByRole('status')).toContainText('Terrain workers unavailable');await expect(page.locator('canvas')).toHaveCount(0);await expect(page.getByRole('button',{name:'Start / Resume',exact:true})).toBeDisabled();
  const context=await browser.newContext(),fallback=await context.newPage();await fallback.addInitScript(()=>{HTMLCanvasElement.prototype.getContext=(()=>null) as typeof HTMLCanvasElement.prototype.getContext;});await fallback.goto('/tools/hordes/');await expect(fallback.getByRole('status')).toContainText('WebGL 2 unavailable');await expect(fallback.getByRole('button',{name:'Start / Resume',exact:true})).toBeDisabled();await context.close();
});
