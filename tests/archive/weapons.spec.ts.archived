import { test,expect,type Page } from '@playwright/test';
const combat=async(page:Page)=>JSON.parse(await page.getByLabel('Combat diagnostics').getAttribute('data-sample')??'{}') as {shots:number;hits:number;damage:number;kills:number;blasts:number;effects:number;capacity:number;droppedEffects:number;voices:number;weapon:string;targets:{id:string;health:number}[]};
const flight=async(page:Page)=>JSON.parse(await page.getByLabel('Flight diagnostics').getAttribute('data-sample')??'{}') as {state:string;resident:number;geometries:number};
async function reset(page:Page){await page.getByRole('button',{name:'Recover / Reset',exact:true}).click();await expect.poll(async()=>(await combat(page)).shots).toBe(0);await expect.poll(async()=>(await flight(page)).state).toBe('ready');}
test('aircraft weapons damage targets, pause on focus loss, switch, explode and reset without resource growth',async({page})=>{
  test.setTimeout(90000);const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto('/tools/weapons/');await expect(page.getByRole('heading',{name:'Weapons lab'})).toBeVisible();await expect.poll(async()=>(await flight(page)).resident).toBe(49);
  await expect(page.getByLabel('Audio status')).toHaveText('Muted');await page.getByRole('button',{name:'Enable sound',exact:true}).click();await expect(page.getByLabel('Audio status')).toHaveText('Enabled');
  await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await page.keyboard.down('Space');await expect.poll(async()=>(await combat(page)).kills).toBeGreaterThan(0);await page.keyboard.up('Space');await page.getByRole('button',{name:'Pause',exact:true}).click();await expect.poll(async()=>(await flight(page)).state).toBe('paused');const stopped=await combat(page);await page.waitForTimeout(250);expect((await combat(page)).shots).toBe(stopped.shots);expect((await combat(page)).voices).toBe(0);
  await page.getByRole('button',{name:'Pause',exact:true}).focus();await page.keyboard.down('Space');await page.waitForTimeout(150);await page.keyboard.up('Space');expect((await combat(page)).shots).toBe(stopped.shots);
  await reset(page);await page.getByLabel('Weapon',{exact:true}).selectOption('autocannon');await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await page.keyboard.down('Space');await expect.poll(async()=>(await combat(page)).hits).toBeGreaterThan(0);await page.keyboard.up('Space');await page.getByRole('button',{name:'Pause',exact:true}).click();const cannon=await combat(page);expect(cannon.damage).toBeGreaterThanOrEqual(22);expect(cannon.damage%22).toBe(0);
  for(let i=0;i<2;i++){
    await reset(page);await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await page.keyboard.press('Digit3');await page.keyboard.down('Space');await expect.poll(async()=>(await combat(page)).blasts).toBeGreaterThan(0);await page.keyboard.up('Space');await page.getByRole('button',{name:'Pause',exact:true}).click();await expect.poll(async()=>(await flight(page)).state).toBe('paused');const blast=await combat(page);expect(blast.weapon).toBe('shell');expect(blast.hits).toBeGreaterThanOrEqual(2);expect(blast.kills).toBeGreaterThanOrEqual(1);expect(blast.effects).toBeLessThanOrEqual(128);expect(blast.voices).toBeLessThanOrEqual(8);expect((await flight(page)).geometries).toBeLessThanOrEqual(59);
  }
  await page.screenshot({path:'test-results/phase-10-explosion.png',fullPage:true});await page.getByRole('button',{name:'Mute sound',exact:true}).click();await expect(page.getByLabel('Audio status')).toHaveText('Muted');await reset(page);expect((await combat(page)).targets.every(t=>t.health>0)).toBe(true);expect((await combat(page)).effects).toBe(0);
  await page.evaluate(()=>{window.dispatchEvent(new Event('pagehide'));window.dispatchEvent(new Event('pagehide'));});await expect(page.locator('canvas')).toHaveCount(0);expect(errors).toEqual([]);
});
test('unavailable sound is reported while authoritative weapons still work',async({page})=>{
  await page.addInitScript(()=>{window.AudioContext=class{constructor(){throw new Error('Audio denied');}} as unknown as typeof AudioContext;});await page.goto('/tools/weapons/');await page.getByRole('button',{name:'Enable sound',exact:true}).click();await expect(page.getByLabel('Audio status')).toContainText('Audio unavailable');await page.getByRole('button',{name:'Start / Resume',exact:true}).click();await page.keyboard.down('Space');await expect.poll(async()=>(await combat(page)).damage).toBeGreaterThan(0);await page.keyboard.up('Space');
});
