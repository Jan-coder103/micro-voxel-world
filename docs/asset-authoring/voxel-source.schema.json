{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:mvw:voxel-source:1",
  "title": "Micro Voxel World editable voxel source v1",
  "description": "Structural schema. Shared validator additionally checks unique palette IDs, coordinate bounds/uniqueness, palette references and an 8 MiB UTF-8 file limit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "units",
    "voxelSize",
    "size",
    "pivot",
    "orientation",
    "palette",
    "cells",
    "tags",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "\\S"
    },
    "category": {
      "enum": [
        "reference",
        "prop",
        "vegetation",
        "building",
        "aircraft",
        "character"
      ]
    },
    "units": {
      "const": "metres"
    },
    "voxelSize": {
      "const": 0.1
    },
    "size": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 256
      }
    },
    "pivot": {
      "const": "base-center"
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "up",
        "front"
      ],
      "properties": {
        "up": {
          "const": "+Y"
        },
        "front": {
          "const": "-Z"
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "color",
          "material"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "material": {
            "const": "matte"
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32768,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "palette"
        ],
        "properties": {
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "palette": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    }
  }
}
